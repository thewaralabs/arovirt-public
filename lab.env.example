# Copy to lab.env (git-ignored) and adjust. The scripts source it.

SUBSCRIPTION_ID=""                 # empty = current `az account`
RESOURCE_GROUP="arovirt-rg"
LOCATION="australiaeast"
ARO_VERSION=""                     # empty = newest version offered in LOCATION (needs 4.21+)

PULL_SECRET_FILE="$HOME/.arovirt/pull-secret.txt"   # from https://console.redhat.com/openshift/install/pull-secret
SSH_PUBLIC_KEY_FILE="$HOME/.ssh/id_ed25519.pub"     # for the client VM and the guests
MY_IP=""                           # CIDR allowed to SSH to the client VM; empty = your current public IP/32

# Deploy a subscription policy that tags the ARO-managed resource group with
# SecurityControl=Ignore at creation. Needed where an inherited policy disables
# storage shared-key access (ARO bootstrap then fails). See docs/lessons-learned.md.
TAG_MANAGED_RG="true"

# The cluster service principal is NOT stored here. Export it in your shell:
#   export ARO_CLIENT_ID=...  ARO_CLIENT_SECRET=...
